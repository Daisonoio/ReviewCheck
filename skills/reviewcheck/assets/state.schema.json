{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daisonoio/ReviewCheck/skills/reviewcheck/assets/state.schema.json",
  "title": "ReviewCheck review state",
  "description": "Saved at <git-dir>/reviewcheck/state.json. Records decisions and file fingerprints, never code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "head", "context_level", "mode", "files", "blocks", "current_block_id", "closed"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["working", "staged", "range", "commit", "pull_request"] },
        "ref": { "type": "string" },
        "repo": { "type": "string", "description": "owner/name, pull_request only" },
        "pr": { "type": "integer", "minimum": 1 },
        "is_self_review": { "type": "boolean" }
      }
    },
    "head": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "context_level": { "enum": ["full", "partial", "diff_only"] },
    "mode": { "enum": ["base", "engine"] },
    "files": {
      "type": "object",
      "description": "path -> output of `git hash-object <path>` at planning time",
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "citations", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^b[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "lines"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "lines": { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" }
              }
            }
          },
          "status": { "enum": ["pending", "accepted", "correction_requested", "reopened"] },
          "note": { "type": "string" }
        }
      }
    },
    "current_block_id": { "type": ["string", "null"] },
    "closed": { "type": "boolean" }
  }
}
